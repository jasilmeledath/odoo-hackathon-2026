# Copy to .env and change JWT_SECRET. Never commit .env.

# Local PostgreSQL. Create the database first: createdb brightloop_subscriptions
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/brightloop_subscriptions?schema=public"

# Long random string used to sign login tokens
JWT_SECRET="change-me-to-a-long-random-string"

PORT=4000

# The Vite dev server: the only origin CORS allows, and the base of emailed links
CLIENT_ORIGIN="http://localhost:5173"

# Leave SMTP_HOST empty to print emails in the server terminal instead of sending them
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Brightloop Billing <billing@demo.test>"

# Subscriptions created by npm run db:seed. Use 5000 to test PS-25 (speed at scale).
SEED_SUBSCRIPTIONS=60
