// The database design. docs/data-model.md explains every table and is updated
// in the same commit as each migration.
//
// Conventions:
// - Tables are snake_case plurals and columns are snake_case (through @@map and
//   @map); Prisma models and fields stay PascalCase and camelCase for the code.
// - Money is whole paise in INTEGER columns (Rs 1,560.00 is 156000). The column
//   types below are the limits; CHECK constraints live in the second migration.
// - Calendar dates are DATE and moments in time are TIMESTAMPTZ.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enumerated values ----------

enum UserRole {
  ADMIN
  INTERNAL
  CUSTOMER

  @@map("user_role")
}

enum ProductType {
  SOFTWARE
  ADD_ON
  SERVICE

  @@map("product_type")
}

enum BillingPeriod {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY

  @@map("billing_period")
}

enum SubscriptionStatus {
  DRAFT
  QUOTATION
  CONFIRMED
  ACTIVE
  PAUSED
  CLOSED

  @@map("subscription_status")
}

enum CloseReason {
  EXPIRED
  CLOSED_EARLY

  @@map("close_reason")
}

enum InvoiceStatus {
  DRAFT
  CONFIRMED
  PAID
  CANCELED

  @@map("invoice_status")
}

enum DiscountType {
  FIXED
  PERCENT

  @@map("discount_type")
}

enum DiscountScope {
  PRODUCT
  SUBSCRIPTION

  @@map("discount_scope")
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  UPI
  CARD
  CHEQUE

  @@map("payment_method")
}

enum ActivityAction {
  CREATED
  UPDATED
  STATUS_CHANGED
  RENEWED
  PAUSED
  RESUMED
  CLOSED
  INVOICED
  SENT
  CANCELED
  PAYMENT_RECORDED

  @@map("activity_action")
}

// ---------- People and access ----------

// A login. Who may sign in lives here; who we bill lives in customers.
model User {
  id                Int       @id @default(autoincrement())
  name              String    @db.VarChar(120)
  email             String    @unique @db.VarChar(254) // PS-1: one account per email, always lowercase
  passwordHash      String    @map("password_hash") @db.VarChar(100)
  role              UserRole  @default(CUSTOMER)
  isActive          Boolean   @default(true) @map("is_active")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  passwordChangedAt DateTime? @map("password_changed_at") @db.Timestamptz(3) // login tokens issued before this stop working

  customer            Customer?
  passwordResetTokens PasswordResetToken[]
  recordedPayments    Payment[]
  activityLogs        ActivityLog[]

  @@index([role])
  @@map("users")
}

// PS-3: only the SHA-256 hash of the emailed token is stored.
model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// A business we bill. Staff can create one before it has a login (PS-11), so
// userId is optional; sign-up links the account by matching the email.
model Customer {
  id          Int      @id @default(autoincrement())
  userId      Int?     @unique @map("user_id")
  name        String   @db.VarChar(120)
  companyName String?  @map("company_name") @db.VarChar(160)
  email       String   @unique @db.VarChar(254)
  phone       String?  @db.VarChar(20)
  address     String?  @db.VarChar(500)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user          User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  subscriptions Subscription[]
  invoices      Invoice[]

  @@index([companyName])
  @@map("customers")
}

// ---------- Catalog ----------

model Tax {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(60)
  ratePercent Decimal  @map("rate_percent") @db.Decimal(5, 2)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  products          Product[]
  subscriptionLines SubscriptionLine[]

  @@map("taxes")
}

model PaymentTerm {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(60) // for example "Net 30"
  dueDays   Int      @map("due_days") // invoice due date = issue date + dueDays
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  subscriptions Subscription[]

  @@map("payment_terms")
}

model Product {
  id         Int         @id @default(autoincrement())
  name       String      @unique @db.VarChar(120)
  type       ProductType
  salesPrice Int         @map("sales_price") // paise
  costPrice  Int         @map("cost_price") // paise
  notes      String?     @db.VarChar(1000)
  taxId      Int?        @map("tax_id") // the tax applied by default on subscription lines
  isActive   Boolean     @default(true) @map("is_active")
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  tax               Tax?                    @relation(fields: [taxId], references: [id], onDelete: SetNull)
  variants          ProductVariant[]
  plans             Plan[]
  templateLines     QuotationTemplateLine[]
  subscriptionLines SubscriptionLine[]
  invoiceLines      InvoiceLine[]
  discountProducts  DiscountProduct[]

  @@index([type, isActive])
  @@index([taxId])
  @@map("products")
}

// PS-7: for example attribute "Brand", value "Odoo", extraPrice 56000 (adds Rs 560).
model ProductVariant {
  id         Int      @id @default(autoincrement())
  productId  Int      @map("product_id")
  attribute  String   @db.VarChar(60)
  value      String   @db.VarChar(60)
  extraPrice Int      @default(0) @map("extra_price") // paise
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  product           Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  templateLines     QuotationTemplateLine[]
  subscriptionLines SubscriptionLine[]

  @@unique([productId, attribute, value])
  @@map("product_variants")
}

model Plan {
  id             Int           @id @default(autoincrement())
  name           String        @unique @db.VarChar(120)
  productId      Int           @map("product_id") // the product this plan sells
  price          Int // paise per unit per billing period; replaces the product's sales price
  billingPeriod  BillingPeriod @map("billing_period")
  minQuantity    Int           @default(1) @map("min_quantity")
  startDate      DateTime      @map("start_date") @db.Date // first day the plan can be sold
  endDate        DateTime?     @map("end_date") @db.Date // last day it can be sold; null means no end
  closesAtExpiry Boolean       @default(false) @map("closes_at_expiry") // PS-9: closes with nobody acting
  canCloseEarly  Boolean       @default(true) @map("can_close_early")
  canPause       Boolean       @default(false) @map("can_pause")
  canRenew       Boolean       @default(true) @map("can_renew")
  isActive       Boolean       @default(true) @map("is_active")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  product       Product             @relation(fields: [productId], references: [id], onDelete: Restrict)
  templates     QuotationTemplate[]
  subscriptions Subscription[]

  @@index([productId])
  @@index([isActive, startDate, endDate])
  @@map("plans")
}

// ---------- Quotations and subscriptions ----------

model QuotationTemplate {
  id           Int      @id @default(autoincrement())
  name         String   @unique @db.VarChar(120)
  planId       Int      @map("plan_id")
  validityDays Int      @map("validity_days") // a quotation from this template expires after this
  notes        String?  @db.VarChar(1000)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  plan          Plan                    @relation(fields: [planId], references: [id], onDelete: Restrict)
  lines         QuotationTemplateLine[]
  subscriptions Subscription[]

  @@index([planId])
  @@map("quotation_templates")
}

// Prices are read from the plan or product when the template is used, so a
// template never quotes an old price.
model QuotationTemplateLine {
  id         Int  @id @default(autoincrement())
  templateId Int  @map("template_id")
  productId  Int  @map("product_id")
  variantId  Int? @map("variant_id")
  quantity   Int  @default(1)

  template QuotationTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  product  Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant  ProductVariant?   @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([templateId])
  @@index([productId])
  @@index([variantId])
  @@map("quotation_template_lines")
}

model Subscription {
  id                     Int                @id @default(autoincrement())
  number                 String             @unique @db.VarChar(20) // SUB-000001
  customerId             Int                @map("customer_id")
  planId                 Int                @map("plan_id")
  templateId             Int?               @map("template_id")
  paymentTermId          Int                @map("payment_term_id")
  status                 SubscriptionStatus @default(DRAFT)
  startDate              DateTime           @map("start_date") @db.Date
  expiryDate             DateTime           @map("expiry_date") @db.Date
  quotationExpiryDate    DateTime?          @map("quotation_expiry_date") @db.Date
  nextInvoiceDate        DateTime?          @map("next_invoice_date") @db.Date // first unbilled day; null when not billable
  recurringAmount        Int                @default(0) @map("recurring_amount") // paise per period, before tax and discount
  monthlyRecurringAmount Int                @default(0) @map("monthly_recurring_amount") // recurringAmount scaled to a month, for reports
  notes                  String?            @db.VarChar(1000)
  closedAt               DateTime?          @map("closed_at") @db.Timestamptz(3)
  closeReason            CloseReason?       @map("close_reason")
  createdAt              DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  customer     Customer           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  plan         Plan               @relation(fields: [planId], references: [id], onDelete: Restrict)
  template     QuotationTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  paymentTerm  PaymentTerm        @relation(fields: [paymentTermId], references: [id], onDelete: Restrict)
  lines        SubscriptionLine[]
  invoices     Invoice[]
  activityLogs ActivityLog[]

  @@index([customerId, status])
  @@index([planId])
  @@index([templateId])
  @@index([paymentTermId])
  @@index([status, nextInvoiceDate])
  @@index([status, expiryDate])
  @@map("subscriptions")
}

model SubscriptionLine {
  id             Int      @id @default(autoincrement())
  subscriptionId Int      @map("subscription_id")
  productId      Int      @map("product_id")
  variantId      Int?     @map("variant_id")
  taxId          Int?     @map("tax_id")
  quantity       Int
  unitPrice      Int      @map("unit_price") // paise, including the variant's extra price
  amount         Int // quantity x unitPrice, before tax and discount
  isActive       Boolean  @default(true) @map("is_active") // PS-27: add-ons switch off without losing the line
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  subscription Subscription    @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  product      Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant      ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  tax          Tax?            @relation(fields: [taxId], references: [id], onDelete: SetNull)

  @@index([subscriptionId])
  @@index([productId])
  @@index([variantId])
  @@index([taxId])
  @@map("subscription_lines")
}

// ---------- Discounts ----------

model Discount {
  id                Int           @id @default(autoincrement())
  name              String        @unique @db.VarChar(120)
  type              DiscountType
  fixedAmount       Int?          @map("fixed_amount") // paise, set only when type is FIXED
  percent           Decimal?      @db.Decimal(5, 2) // set only when type is PERCENT
  scope             DiscountScope // PRODUCT: listed products only; SUBSCRIPTION: the whole invoice
  minPurchaseAmount Int           @default(0) @map("min_purchase_amount") // paise
  minQuantity       Int           @default(0) @map("min_quantity")
  startDate         DateTime      @map("start_date") @db.Date
  endDate           DateTime      @map("end_date") @db.Date
  usageLimit        Int?          @map("usage_limit") // null means unlimited
  usageCount        Int           @default(0) @map("usage_count") // one per invoice; given back on cancel
  isActive          Boolean       @default(true) @map("is_active")
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  products DiscountProduct[]
  invoices Invoice[]

  @@index([isActive, startDate, endDate])
  @@map("discounts")
}

model DiscountProduct {
  discountId Int @map("discount_id")
  productId  Int @map("product_id")

  discount Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@id([discountId, productId])
  @@index([productId])
  @@map("discount_products")
}

// ---------- Billing ----------

// PS-15: a partial unique index in the second migration allows only one
// non-canceled invoice per subscription and period, so nothing bills twice.
model Invoice {
  id              Int           @id @default(autoincrement())
  number          String        @unique @db.VarChar(20) // INV-000001
  subscriptionId  Int           @map("subscription_id")
  customerId      Int           @map("customer_id") // copied so portal and overdue lists need no join
  discountId      Int?          @map("discount_id")
  status          InvoiceStatus @default(DRAFT)
  billingName     String        @map("billing_name") @db.VarChar(160) // snapshot: issued invoices never change
  billingAddress  String?       @map("billing_address") @db.VarChar(500)
  issueDate       DateTime      @map("issue_date") @db.Date
  dueDate         DateTime      @map("due_date") @db.Date
  periodStartDate DateTime      @map("period_start_date") @db.Date
  periodEndDate   DateTime      @map("period_end_date") @db.Date
  subtotalAmount  Int           @map("subtotal_amount") // sum of line amounts
  discountAmount  Int           @default(0) @map("discount_amount")
  taxAmount       Int           @map("tax_amount")
  totalAmount     Int           @map("total_amount") // subtotal - discount + tax
  paidAmount      Int           @default(0) @map("paid_amount") // kept in step with payments so lists stay fast
  sentAt          DateTime?     @map("sent_at") @db.Timestamptz(3)
  confirmedAt     DateTime?     @map("confirmed_at") @db.Timestamptz(3)
  paidAt          DateTime?     @map("paid_at") @db.Timestamptz(3)
  canceledAt      DateTime?     @map("canceled_at") @db.Timestamptz(3)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  subscription Subscription  @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  discount     Discount?     @relation(fields: [discountId], references: [id], onDelete: SetNull)
  lines        InvoiceLine[]
  payments     Payment[]
  activityLogs ActivityLog[]

  @@index([customerId, status])
  @@index([subscriptionId])
  @@index([discountId])
  @@index([status, dueDate])
  @@index([issueDate])
  @@map("invoices")
}

// A snapshot of the subscription line at billing time, so later price or tax
// changes never alter an issued invoice.
model InvoiceLine {
  id             Int     @id @default(autoincrement())
  invoiceId      Int     @map("invoice_id")
  productId      Int     @map("product_id")
  description    String  @db.VarChar(200)
  quantity       Int
  unitPrice      Int     @map("unit_price") // paise
  amount         Int // quantity x unitPrice
  discountAmount Int     @default(0) @map("discount_amount") // this line's share of the invoice discount
  taxName        String? @map("tax_name") @db.VarChar(60)
  taxRatePercent Decimal @default(0) @map("tax_rate_percent") @db.Decimal(5, 2)
  taxAmount      Int     @default(0) @map("tax_amount") // tax on amount - discountAmount, rounded per line

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([invoiceId])
  @@index([productId])
  @@map("invoice_lines")
}

model Payment {
  id           Int           @id @default(autoincrement())
  invoiceId    Int           @map("invoice_id")
  recordedById Int           @map("recorded_by_id")
  method       PaymentMethod
  amount       Int // paise
  paymentDate  DateTime      @map("payment_date") @db.Date
  note         String?       @db.VarChar(500)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  invoice    Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  recordedBy User    @relation(fields: [recordedById], references: [id], onDelete: Restrict)

  @@index([invoiceId])
  @@index([paymentDate])
  @@index([recordedById])
  @@map("payments")
}

// ---------- Support ----------

// The timeline on subscription and invoice pages (PS-13). Real foreign keys
// rather than a generic entity id, so the database protects the links. An
// invoice event also carries its subscription, so both timelines show it.
model ActivityLog {
  id             Int            @id @default(autoincrement())
  subscriptionId Int?           @map("subscription_id")
  invoiceId      Int?           @map("invoice_id")
  actorId        Int?           @map("actor_id") // null when the scheduler did the work
  action         ActivityAction
  detail         String?        @db.VarChar(500)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  invoice      Invoice?      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  actor        User?         @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([subscriptionId, createdAt])
  @@index([invoiceId, createdAt])
  @@index([actorId])
  @@map("activity_logs")
}

// Gapless document numbers. The row is locked until the creating transaction
// commits, which a plain database sequence does not guarantee: invoices must
// not have holes in their numbering.
model DocumentCounter {
  key   String @id @db.VarChar(30) // SUBSCRIPTION | INVOICE
  value Int    @default(0)

  @@map("document_counters")
}
