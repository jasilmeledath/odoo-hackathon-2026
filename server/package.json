{
  "name": "server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --import=tsx --watch --env-file=.env src/index.js",
    "start": "node --import=tsx --env-file=.env src/index.js",
    "test": "node --import=tsx --test \"src/**/*.test.js\"",
    "db:migrate": "prisma migrate dev && npm run db:generate",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:seed": "node --import=tsx --env-file=.env prisma/seed.js",
    "db:reset": "prisma migrate reset --force && npm run db:generate && npm run db:seed",
    "prisma:seed": "node --import=tsx --env-file=.env prisma/seed.js",
    "test:integration": "node --import=tsx --test \"test/*.test.js\""
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "18.0.9",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.3.1",
    "pg": "8.23.1",
    "tsx": "4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "prisma": "7.10.1"
  }
}
