#!/bin/sh
# Run the local CI gate before every branch push and keep main PR-only.
set -eu

while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    printf '%s\n' 'Direct pushes to main are blocked. Run `npm run promote:main` to validate develop and open a promotion PR.' >&2
    exit 1
  fi
done

printf '%s\n' 'Running local CI before push...'
npm run ci:local

exit 0
